# Shell scripts must keep LF endings. A CRLF script fails on Linux with
# `$'\r': command not found`, which is a confusing way to learn that a file was
# written on Windows.
*.sh text eol=lf

# So must anything a Linux container or CI runner executes or parses.
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# Compact sources and the TypeScript around them are normalised for the same
# reason: the toolchain runs under WSL or Linux CI.
*.compact text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
