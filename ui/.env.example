# QuietBooks interface configuration.
#
# Copy to `.env.local` and edit. Every endpoint here is optional: left unset, the
# interface takes the matching value from the connected wallet's own
# configuration, which is the right default on a public network. Set them
# explicitly when you run your own indexer or proof server, or when you point the
# interface at the local node in `../localnet`.

# Which network the wallet is asked to connect to, and which network id the
# contract addresses belong to. One of: undeployed, preview, preprod, mainnet.
# The wallet refuses the connection if this does not match the network it is on.
#
# `testnet` is not a valid value any more. That network was retired and its
# endpoints no longer resolve; use `preview` or `preprod` instead.
#
# Unset, this is `undeployed`, which is the local network `../localnet` brings
# up. Lace's own defaults for `undeployed` are localhost:9944, localhost:8088
# and localhost:6300, which is what the compose file publishes, so the three
# endpoints below can stay blank for local work.
VITE_NETWORK_ID=undeployed

# Indexer GraphQL endpoint. Read path only: the interface never writes here.
# Local network:
#   http://127.0.0.1:8088/api/v4/graphql
VITE_INDEXER_URI=

# Indexer subscription endpoint. Same service, websocket transport. This is what
# keeps the invoice list current without polling.
#   ws://127.0.0.1:8088/api/v4/graphql/ws
VITE_INDEXER_WS_URI=

# Proof server. Every write in QuietBooks is a zero-knowledge proof, and it is
# built here, not in the browser. `../localnet` runs one; to run it alone, the
# pinned image is:
#   docker run -p 6300:6300 midnightntwrk/proof-server:8.1.0 midnight-proof-server -v
# Nothing private leaves the machine this points at, so point it at localhost
# unless you control the remote host.
VITE_PROOF_SERVER_URI=http://localhost:6300

# Where the compiled proving keys are served from. Defaults to this application's
# own origin, which is what both `npm run dev` and `npm run build` set up by
# copying `../contract/build/{keys,zkir}`. Change it only if you host the key
# material somewhere else.
VITE_ZK_CONFIG_URI=
