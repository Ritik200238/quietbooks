# QuietBooks interface configuration.
#
# Copy to `.env.local` and edit. Every value here is optional: when a variable is
# left unset the interface uses the matching value from the connected Lace
# wallet's own configuration, which is the right default for TestNet. Set them
# explicitly when you run your own indexer or proof server, or when you point the
# interface at a local node.

# Which network the wallet is asked to connect to, and which network id the
# contract addresses belong to. One of: undeployed, devnet, testnet.
# The wallet refuses the connection if this does not match the network it is on.
VITE_NETWORK_ID=testnet

# Indexer GraphQL endpoint. Read path only: the interface never writes here.
# Wallet default on TestNet:
#   https://indexer.testnet-02.midnight.network/api/v1/graphql
VITE_INDEXER_URI=

# Indexer subscription endpoint. Same service, websocket transport. This is what
# keeps the invoice list current without polling.
#   wss://indexer.testnet-02.midnight.network/api/v1/graphql/ws
VITE_INDEXER_WS_URI=

# Proof server. Every write in QuietBooks is a zero-knowledge proof, and it is
# built here, not in the browser. Run your own:
#   docker run -p 6300:6300 midnightnetwork/proof-server:latest -- \
#     'midnight-proof-server --network testnet'
# Nothing private leaves the machine this points at, so point it at localhost
# unless you control the remote host.
VITE_PROOF_SERVER_URI=http://localhost:6300

# Where the compiled proving keys are served from. Defaults to this application's
# own origin, which is what both `npm run dev` and `npm run build` set up by
# copying `../contract/build/{keys,zkir}`. Change it only if you host the key
# material somewhere else.
VITE_ZK_CONFIG_URI=
