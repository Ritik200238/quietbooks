// QuietBooks .. private B2B invoicing, settlement and selective audit on Midnight.
//
// SPDX-License-Identifier: Apache-2.0
// Copyright (c) 2026 QuietBooks contributors
//
// WHAT IS PRIVATE, AND WHY
// ------------------------
// Every commercial term of an invoice .. amount, tax, currency, line items, memo
// and order reference .. lives in the parties' local private state. The ledger
// stores only a hiding commitment to those terms plus nine per-field commitments
// that make selective disclosure possible later. No amount is ever written to
// public state by any circuit in this file.
//
// Settlement is deliberately NOT custodial in the private mode. This is a
// consequence of the platform, not a shortcut, and the reasoning is recorded
// here because it drove the whole design:
//
//   * `receiveShielded` requires its coin argument to be disclosed (see the
//     official token-transfers example, which writes `receiveShielded(disclose(coin))`).
//     A coin's `value` field is therefore visible to the circuit, and a contract
//     that HOLDS a coin publishes the held value in its balance. Contract
//     custody and a hidden amount are mutually exclusive on Midnight today.
//   * A contract can still route a payment without holding it. `receiveShielded`
//     followed by `sendImmediateShielded` in the same call takes the coin and
//     passes it straight on, so the contract's balance changes by zero and
//     nothing is ever in its custody. Zswap hides the value on both legs. This
//     is the shape OpenZeppelin's `ForwarderShielded._deposit` uses.
//
// So the private mode settles buyer -> contract -> seller inside one transaction.
// The chain learns that invoice X was settled and when; it never learns for how
// much. The circuit additionally proves the payment equals the invoiced total,
// by comparing the coin against the terms the payer has just proven they hold,
// so neither figure reaches public state and a buyer cannot settle by underpaying.
//
// A previous version of this contract tried to bind an ordinary buyer-to-seller
// transfer with `kernel.claimZswapCoinReceive(note)`, taking the note commitment
// as an argument. That cannot work, and it is worth stating plainly because the
// in-process tests could not show it: the ledger requires every
// contract-associated commitment to be claimed by the contract that owns it, so
// a receive claim only ever accepts the commitment of an output addressed to
// THIS contract. A payment addressed to the seller is not, so every such
// transaction was refused as malformed. Circuit tests that never build a
// transaction cannot catch this; the end-to-end run against a real node is what
// does.
//
// The escrow mode is offered as the honest alternative for parties who want funds
// actually locked by the contract. It takes custody, and it therefore makes the
// escrowed amount public. The UI labels this plainly. Offering both, and being
// explicit about the trade, is the point.
//
// IDENTITY
// --------
// Identity is derived from a 32-byte secret held in local private state, never
// from `ownPublicKey()`. `ownPublicKey()` returns a prover-claimed value with no
// cryptographic binding to the transaction signer, so any assertion resting on it
// is bypassable. Party keys are PIN-rotatable: rotating the PIN yields a fresh
// key and breaks linkability with the old one, at the cost of that key's history.

pragma language_version 0.23;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Domain separation
//
// Every hash and commitment in this contract is prefixed with a distinct tag so
// that a digest produced for one purpose can never be replayed as another. The
// version suffix lets a future revision change a derivation without colliding
// with values already on the ledger.
// ---------------------------------------------------------------------------

export circuit tagParty(): Bytes<32> { return pad(32, "quietbooks:party:v1"); }
export circuit tagAdmin(): Bytes<32> { return pad(32, "quietbooks:admin:v1"); }
export circuit tagInvoiceId(): Bytes<32> { return pad(32, "quietbooks:invoice-id:v1"); }
export circuit tagTerms(): Bytes<32> { return pad(32, "quietbooks:terms:v1"); }
export circuit tagFieldRoot(): Bytes<32> { return pad(32, "quietbooks:field-root:v1"); }
export circuit tagSettlement(): Bytes<32> { return pad(32, "quietbooks:settlement:v1"); }
export circuit tagEscrowCoin(): Bytes<32> { return pad(32, "quietbooks:escrow-coin:v1"); }
export circuit tagPaidCoin(): Bytes<32> { return pad(32, "quietbooks:paid-coin:v1"); }
export circuit tagReliability(): Bytes<32> { return pad(32, "quietbooks:reliability:v1"); }

// Per-field tags. The ordering is fixed and mirrors the scope bit positions in
// `SCOPE_*` below; an auditor recomputes exactly these.
export circuit tagFieldAmount(): Bytes<32> { return pad(32, "quietbooks:f:amount:v1"); }
export circuit tagFieldTax(): Bytes<32> { return pad(32, "quietbooks:f:tax:v1"); }
export circuit tagFieldDueDate(): Bytes<32> { return pad(32, "quietbooks:f:due:v1"); }
export circuit tagFieldBuyer(): Bytes<32> { return pad(32, "quietbooks:f:buyer:v1"); }
export circuit tagFieldSeller(): Bytes<32> { return pad(32, "quietbooks:f:seller:v1"); }
export circuit tagFieldCurrency(): Bytes<32> { return pad(32, "quietbooks:f:currency:v1"); }
export circuit tagFieldItems(): Bytes<32> { return pad(32, "quietbooks:f:items:v1"); }
export circuit tagFieldMemo(): Bytes<32> { return pad(32, "quietbooks:f:memo:v1"); }
export circuit tagFieldOrderRef(): Bytes<32> { return pad(32, "quietbooks:f:order:v1"); }

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

export enum InvoiceStatus {
  // Slot 0 is the default for the type. Keeping an explicit `nonexistent`
  // variant means a zeroed struct can never be mistaken for a live invoice.
  nonexistent,
  issued,
  settled,
  cancelled,
  escrowFunded,
  disputed,
  resolved,
  refunded
}

export enum SettlementMode {
  none,
  // Peer-to-peer shielded transfer bound to this invoice by its Zswap note
  // commitment. Amount hidden from the ledger.
  privateNote,
  // Seller attests receipt without an in-transaction note binding. Used when
  // the payment happened out of band, or on a rail the contract cannot observe.
  attested,
  // Contract custody. Amount is public. See the header.
  escrow
}

export enum DisputeOutcome {
  undecided,
  forSeller,
  forBuyer
}

// The public record of an invoice. Contains no commercial value of any kind:
// every number here is either a timestamp, a status, or a 32-byte digest.
//
// The timestamps are the caller's claim, and the contract cannot make them
// anything else. Compact exposes the chain's clock only as four comparisons
// .. `blockTimeLt`, `blockTimeLte`, `blockTimeGt`, `blockTimeGte`
// (`compact/standard-library/exports.md`) .. and no circuit that returns the
// time, so a contract can test a date but never record one. Every date stored
// here is therefore a label, not evidence.
//
// What matters is that no rule reads them. Punctuality, escrow deadlines and
// audit-grant windows are all decided by comparing against the block, and the
// three places that once compared one caller argument to another are gone. The
// dates stay because a reader wants to see what the parties said, and because
// refusing to store them would not make the parties any more honest.
export struct InvoiceAnchor {
  status: InvoiceStatus,
  // persistentCommit(TermsFrame, termsSalt) .. binds amount, tax, currency,
  // order reference, item hash and memo hash to this invoice's identity.
  terms: Bytes<32>,
  // persistentHash over the nine per-field commitments, in SCOPE bit order.
  fieldRoot: Bytes<32>,
  sellerKey: Bytes<32>,
  buyerKey: Bytes<32>,
  // Zero when the invoice has no arbiter. A dispute can only be resolved when
  // an arbiter was named at issuance, so neither party can appoint one later.
  arbiterKey: Bytes<32>,
  issuedAt: Uint<64>,
  dueDate: Uint<64>,
  settledAt: Uint<64>,
  // Governs `refundEscrow`. Zero when the invoice is not escrow-funded.
  escrowDeadline: Uint<64>,
  rulesVersion: Uint<8>
}

// What the ledger records about a settlement. `note` is a Zswap coin commitment
// for `privateNote`, a caller-supplied receipt digest for `attested`, and the
// escrow coin commitment for `escrow`.
export struct Settlement {
  mode: SettlementMode,
  note: Bytes<32>,
  // persistentCommit over (invoiceId, note, payerKey) .. lets an auditor confirm
  // the settlement belongs to this invoice and this payer without either being
  // recomputable from the digest alone.
  receipt: Bytes<32>,
  settledAt: Uint<64>,
  onTime: Boolean
}

// An auditor's permission to see specific fields of one invoice, for a limited
// time. Modelled on the qualified-invoice audit flow: the auditor never touches
// the chain to read data, they recompute commitments from an envelope the seller
// hands them and check those commitments against this grant.
export struct AuditGrant {
  // persistentHash of the symmetric audit key the seller shares out of band.
  // The key itself never reaches the ledger.
  auditKeyHash: Bytes<32>,
  // One slot per disclosable field, in the scope order documented above. Fields
  // whose slot is false must stay masked in the envelope, and a validator
  // rejects an envelope that discloses more than its grant allows.
  scopes: Vector<9, Boolean>,
  grantedAt: Uint<64>,
  expiresAt: Uint<64>,
  revoked: Boolean
}

// Counts only. No amounts, ever.
//
// The settlement, cancellation and dispute paths keep these up to date, and a
// reader takes them from public ledger state. The circuit that proved a
// threshold over them -- "I have settled at least N, at least M on time" --
// without disclosing the counts is Wave 2 work: every entry point costs a
// verifier key in the deploy transaction, and a deploy has to fit inside one
// block's write budget. The record is accumulated now so that proof has
// something to run against later.
export struct Reliability {
  settled: Uint<64>,
  settledOnTime: Uint<64>,
  cancelled: Uint<64>,
  disputesOpened: Uint<64>,
  disputesLost: Uint<64>
}

// The private commercial terms. This struct is witness data. It is never a
// circuit return value and never reaches the ledger.
export struct InvoiceTerms {
  amount: Uint<128>,
  taxAmount: Uint<128>,
  // The human label, e.g. "USDM". It names a denomination to a reader; it is
  // not a token and nothing can be paid to it.
  currency: Bytes<32>,
  // Where each side is paid, as Zswap coin public keys.
  //
  // These live in the terms rather than on the public anchor for two reasons.
  // They stay private, so an observer cannot link every invoice a seller issues
  // by a repeated payout address; and they are already bound by the terms
  // commitment the chain has held since issuance, so neither party can redirect
  // a payment afterwards.
  //
  // Without them every paying circuit took its recipient as a free argument and
  // asserted nothing about it, so a buyer could route their own settlement back
  // to themselves and still mark the invoice paid.
  sellerPayout: Bytes<32>,
  buyerPayout: Bytes<32>,
  // The shielded token this invoice is payable in, as Zswap's own colour.
  //
  // Separate from `currency` because the two answer different questions, and
  // conflating them is how an invoice reading "USD 1,250.00" gets settled with
  // 1,250,000,000 units of something worthless. The settlement and escrow paths
  // compare a coin against this, so a payment in the wrong token is refused
  // rather than recorded.
  //
  // It lives in the terms rather than on the public anchor so that which token
  // an invoice is denominated in stays between the parties, and it is bound by
  // the terms commitment the chain has held since issuance, so neither party
  // can change it afterwards.
  tokenType: Bytes<32>,
  orderRef: Bytes<32>,
  itemsHash: Bytes<32>,
  memoHash: Bytes<32>
}

// The frame the terms commitment is taken over. Binding the invoice identity and
// both party keys into the frame means a commitment lifted from one invoice
// cannot be replayed onto another.
export struct TermsFrame {
  invoiceId: Bytes<32>,
  sellerKey: Bytes<32>,
  buyerKey: Bytes<32>,
  dueDate: Uint<64>,
  terms: InvoiceTerms
}

// ---------------------------------------------------------------------------
// Audit scopes.
//
// A grant is a nine-slot boolean vector, one slot per disclosable field, in the
// fixed order used everywhere in this contract:
//
//   0 amount   1 tax     2 dueDate   3 buyer   4 seller
//   5 currency 6 items   7 memo      8 orderRef
//
// Compact has no bitwise operators .. arithmetic is `+`, `-` and `*` only .. so
// an integer bitmask cannot be tested in-circuit. The vector is the honest
// representation of the same idea and reads better at the call site. The
// off-chain envelope format still carries a bitmask, because JSON and a
// nine-element array are equally expressive and a mask is what auditors expect;
// the TypeScript layer converts between the two.
// ---------------------------------------------------------------------------

export circuit SCOPE_COUNT(): Uint<8> { return 9; }

// The rule set version enforced by `issueInvoice`. Bumping this signals to
// auditors that the acceptance criteria changed.
//
// 1: the original set .. positive amount, tax within the principal, due date
//    after issuance, both parties named and distinct, currency set, total
//    payable as a single coin.
// 2: the token an invoice is payable in became part of the terms.
// 3: an invoice must name where the seller is paid, and an invoice that names an
//    arbiter must name a separate address for the buyer.
export circuit RULES_VERSION(): Uint<8> { return 3; }

// ---------------------------------------------------------------------------
// Ledger
// ---------------------------------------------------------------------------

// Immutable per-deployment salt. Mixed into every party key so the same wallet
// secret yields different identities on different deployments, which stops an
// observer correlating a party across contracts.
export sealed ledger instanceSalt: Bytes<32>;

// Administrative identity, as a derived key. Holds only the pause switch and its
// own rotation .. it can never move funds, read terms, or alter an invoice.
export ledger admin: Bytes<32>;

// Emergency stop for state-advancing circuits. Reads and audit revocation stay
// available while paused so nobody is locked away from their own records.
export ledger paused: Boolean;

export ledger invoices: Map<Bytes<32>, InvoiceAnchor>;
export ledger settlements: Map<Bytes<32>, Settlement>;
export ledger auditGrants: Map<Bytes<32>, AuditGrant>;
export ledger reliability: Map<Bytes<32>, Reliability>;

// Escrow custody. Present only for the escrow mode, and the reason that mode
// makes amounts public: a `QualifiedShieldedCoinInfo` carries a plaintext value.
export ledger escrowVault: Map<Bytes<32>, QualifiedShieldedCoinInfo>;

// Dispute outcomes, kept out of the anchor so resolving one does not rewrite the
// invoice record.
export ledger disputes: Map<Bytes<32>, DisputeOutcome>;

// Aggregate counters for the public dashboard. Increment-only, and readable by
// the indexer without opening anything.
export ledger issuedCount: Counter;
export ledger settledCount: Counter;
export ledger cancelledCount: Counter;
export ledger disputedCount: Counter;

// ---------------------------------------------------------------------------
// Witnesses .. supplied by the local wallet, never transmitted.
// ---------------------------------------------------------------------------

// The wallet's root secret. Every identity this contract recognises is a
// domain-separated hash of it.
witness localSecret(): Bytes<32>;

// The private commercial terms of the invoice being acted on.
witness invoiceTerms(): InvoiceTerms;

// Opening for the terms commitment. Must be fresh, 32 bytes, non-zero: the
// commitment's hiding property rests on it.
witness termsSalt(): Bytes<32>;

// Per-field commitment openings, in SCOPE bit order:
// amount, tax, dueDate, buyer, seller, currency, items, memo, orderRef.
witness fieldSalts(): Vector<9, Bytes<32>>;

// Opening for the invoice identifier, which is a commitment rather than a
// counter so that identifiers are unlinkable and unguessable.
witness invoiceNonce(): Bytes<32>;

// Opening for a settlement receipt.
//
// There is deliberately no witness for the escrowed coin. `escrowVault` holds a
// `QualifiedShieldedCoinInfo` in public ledger state, so release and refund read
// the coin from the ledger rather than trusting the caller to present it. That
// is the same trade `ShieldedTreasury` makes: the value is public either way
// once the contract has custody, and reading it from state removes the failure
// mode where a lost coin descriptor strands the funds forever.
witness settlementSalt(): Bytes<32>;

constructor(salt: Bytes<32>) {
  // A zero salt would collapse this deployment's party keys onto any other
  // zero-salted deployment, so refuse it. The field is sealed, so a mistake here
  // would be permanent.
  assert(disclose(salt) != default<Bytes<32>>, "quietbooks: instance salt must be non-zero");
  instanceSalt = disclose(salt);
  admin = disclose(deriveAdminKeyWith(disclose(salt), localSecret()));
  paused = false;
}

// ---------------------------------------------------------------------------
// Identity derivation
// ---------------------------------------------------------------------------

// A party's public identity. PIN-rotatable: a different PIN yields an unrelated
// key, which is how a party sheds a history that has become too linkable.
//
// Declared pure and taking the salt explicitly so that a wallet can derive the
// same key off chain. The seller needs their own key to compute an invoice
// identifier before any transaction exists, and a buyer needs to hand out a key
// to be invoiced against; neither can call into a contract to get one.
//
// There is deliberately no impure wrapper that reads `instanceSalt` and calls
// this. It would be an entry point, and an entry point costs a verifier key in
// every deploy transaction whether or not anyone ever submits it. Callers that
// hold a deployment read the salt from ledger state and call this directly.
export pure circuit derivePartyKeyWith(
  salt: Bytes<32>,
  secret: Bytes<32>,
  pin: Uint<64>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    tagParty(),
    salt,
    pin as Field as Bytes<32>,
    secret
  ]);
}

// The administrative identity. Not PIN-bound, so the role survives the admin
// rotating their own party PIN.
export pure circuit deriveAdminKeyWith(salt: Bytes<32>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    tagAdmin(),
    salt,
    secret
  ]);
}

// The caller's party key for a given PIN, from their own secret.
circuit callerKey(pin: Uint<64>): Bytes<32> {
  return derivePartyKeyWith(instanceSalt, localSecret(), pin);
}

circuit assertNotPaused(): [] {
  assert(!paused, "quietbooks: contract is paused");
}

circuit assertAdmin(): [] {
  assert(deriveAdminKeyWith(instanceSalt, localSecret()) == admin,
         "quietbooks: caller is not the admin");
}

// ---------------------------------------------------------------------------
// Commitments
// ---------------------------------------------------------------------------

// The invoice identifier. A commitment, not a sequence number: sequential ids
// would leak issuance volume and let anyone probe for an invoice's existence.
export circuit deriveInvoiceId(sellerKey: Bytes<32>, nonce: Bytes<32>): Bytes<32> {
  return persistentCommit<Vector<2, Bytes<32>>>([tagInvoiceId(), sellerKey], nonce);
}

export circuit commitTerms(frame: TermsFrame, salt: Bytes<32>): Bytes<32> {
  return persistentCommit<TermsFrame>(frame, salt);
}

// One field's commitment. The tag keeps a value committed as `amount` from ever
// verifying as `tax`, even when the two happen to be numerically equal.
export circuit commitField(tag: Bytes<32>, value: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return persistentCommit<Vector<2, Bytes<32>>>([tag, value], salt);
}

// The nine per-field commitments, folded into one digest stored on the anchor.
// An auditor recomputes the fields they were granted, takes the masked
// commitments for the rest from the envelope, and rebuilds this exact root.
export circuit commitFieldRoot(
  frame: TermsFrame,
  salts: Vector<9, Bytes<32>>
): Bytes<32> {
  const commits: Vector<9, Bytes<32>> = [
    commitField(tagFieldAmount(),   frame.terms.amount as Field as Bytes<32>,    salts[0]),
    commitField(tagFieldTax(),      frame.terms.taxAmount as Field as Bytes<32>, salts[1]),
    commitField(tagFieldDueDate(),  frame.dueDate as Field as Bytes<32>,         salts[2]),
    commitField(tagFieldBuyer(),    frame.buyerKey,                              salts[3]),
    commitField(tagFieldSeller(),   frame.sellerKey,                             salts[4]),
    commitField(tagFieldCurrency(), frame.terms.currency,                        salts[5]),
    commitField(tagFieldItems(),    frame.terms.itemsHash,                       salts[6]),
    commitField(tagFieldMemo(),     frame.terms.memoHash,                        salts[7]),
    commitField(tagFieldOrderRef(), frame.terms.orderRef,                        salts[8])
  ];
  return persistentHash<Vector<10, Bytes<32>>>([
    tagFieldRoot(),
    commits[0], commits[1], commits[2], commits[3], commits[4],
    commits[5], commits[6], commits[7], commits[8]
  ]);
}

export circuit commitSettlementReceipt(
  invoiceId: Bytes<32>,
  note: Bytes<32>,
  payerKey: Bytes<32>,
  salt: Bytes<32>
): Bytes<32> {
  return persistentCommit<Vector<4, Bytes<32>>>(
    [tagSettlement(), invoiceId, note, payerKey],
    salt
  );
}

// Binds an escrowed coin so that whoever releases it must present the same coin.
// The digest hides the value; the vault entry does not, which is the documented
// cost of escrow mode.
// The digest recorded against a privately settled invoice.
//
// The nonce is 32 bytes the buyer drew at random for this one coin and never
// publishes, so it blinds the value: an auditor handed the coin can recompute
// this digest and confirm exactly what was paid, and nobody else can invert it
// even though invoice amounts are low-entropy. Same construction as
// `commitEscrowCoin`, under its own tag so an escrow digest can never be
// replayed as a payment digest.
export circuit commitPaidCoin(coin: ShieldedCoinInfo): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    tagPaidCoin(),
    coin.nonce,
    coin.color,
    coin.value as Field as Bytes<32>
  ]);
}

export circuit commitEscrowCoin(coin: QualifiedShieldedCoinInfo): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    tagEscrowCoin(),
    coin.nonce,
    coin.color,
    coin.value as Field as Bytes<32>
  ]);
}

// ---------------------------------------------------------------------------
// Rule set, version 1.
//
// These are enforced, not merely recorded. A transaction that violates one
// cannot be produced, so the proof itself is the evidence the rules held .. which
// is why the anchor stores only the rule set's version and not a result digest.
// ---------------------------------------------------------------------------

circuit assertTermsValid(frame: TermsFrame, issuedAt: Uint<64>): [] {
  assert(frame.terms.amount > 0, "quietbooks: amount must be positive");
  assert(frame.dueDate > issuedAt, "quietbooks: due date must be after issuance");
  assert(frame.terms.currency != default<Bytes<32>>, "quietbooks: currency must be set");
  assert(frame.sellerKey != frame.buyerKey, "quietbooks: seller and buyer must differ");
  assert(frame.sellerKey != default<Bytes<32>>, "quietbooks: seller key must be set");
  assert(frame.buyerKey != default<Bytes<32>>, "quietbooks: buyer key must be set");
  // Every paying circuit now sends to the address the terms name and to no
  // other, so an invoice naming nobody is an invoice whose settlement burns the
  // payment. The local witness refuses this too, but the local witness is the
  // honest prover: this is the copy of the rule an attacker cannot replace.
  assert(frame.terms.sellerPayout != default<Bytes<32>>,
         "quietbooks: seller payout address must be set");
  // Tax is expressed on top of the principal. Allowing it to exceed the
  // principal admits no real invoice and would let a payer be over-charged
  // through a malformed envelope the auditor could not distinguish from a
  // legitimate one.
  assert(frame.terms.taxAmount <= frame.terms.amount, "quietbooks: tax cannot exceed amount");
  // An invoice whose total cannot be expressed as a coin can never be settled,
  // because a shielded coin's value is a Uint<128>. Refusing it at issuance
  // beats stranding it.
  assert(frame.terms.amount + frame.terms.taxAmount <= 340282366920938463463374607431768211455,
         "quietbooks: invoice total is too large to be paid");
}

// ---------------------------------------------------------------------------
// Reliability counters
// ---------------------------------------------------------------------------

circuit readReliability(key: Bytes<32>): Reliability {
  if (!reliability.member(key)) {
    return Reliability {
      settled: 0 as Uint<64>,
      settledOnTime: 0 as Uint<64>,
      cancelled: 0 as Uint<64>,
      disputesOpened: 0 as Uint<64>,
      disputesLost: 0 as Uint<64>
    };
  }
  return reliability.lookup(key);
}

circuit bumpSettled(key: Bytes<32>, onTime: Boolean): [] {
  const r = readReliability(key);
  reliability.insert(key, Reliability {
    settled: (r.settled + 1) as Uint<64>,
    settledOnTime: onTime ? ((r.settledOnTime + 1) as Uint<64>) : r.settledOnTime,
    cancelled: r.cancelled,
    disputesOpened: r.disputesOpened,
    disputesLost: r.disputesLost
  });
}

circuit bumpCancelled(key: Bytes<32>): [] {
  const r = readReliability(key);
  reliability.insert(key, Reliability {
    settled: r.settled,
    settledOnTime: r.settledOnTime,
    cancelled: (r.cancelled + 1) as Uint<64>,
    disputesOpened: r.disputesOpened,
    disputesLost: r.disputesLost
  });
}

circuit bumpDisputeOpened(key: Bytes<32>): [] {
  const r = readReliability(key);
  reliability.insert(key, Reliability {
    settled: r.settled,
    settledOnTime: r.settledOnTime,
    cancelled: r.cancelled,
    disputesOpened: (r.disputesOpened + 1) as Uint<64>,
    disputesLost: r.disputesLost
  });
}

circuit bumpDisputeLost(key: Bytes<32>): [] {
  const r = readReliability(key);
  reliability.insert(key, Reliability {
    settled: r.settled,
    settledOnTime: r.settledOnTime,
    cancelled: r.cancelled,
    disputesOpened: r.disputesOpened,
    disputesLost: (r.disputesLost + 1) as Uint<64>
  });
}

// ---------------------------------------------------------------------------
// Invoice lifecycle
// ---------------------------------------------------------------------------

// Issue an invoice. Called by the seller.
//
// Public:  the invoice identifier, both party keys, the arbiter key, the two
//          timestamps, and three digests.
// Private: amount, tax, currency, order reference, item hash, memo hash, and
//          every commitment opening.
//
// The commitments are computed in-circuit from witness data rather than accepted
// as arguments, so what the ledger records can never drift from what the seller's
// wallet actually holds.
export circuit issueInvoice(
  sellerPin: Uint<64>,
  buyerKey: Bytes<32>,
  arbiterKey: Bytes<32>,
  dueDate: Uint<64>,
  issuedAt: Uint<64>
): Bytes<32> {
  assertNotPaused();

  const sellerKey = callerKey(sellerPin);
  const nonce = invoiceNonce();
  const invoiceId = deriveInvoiceId(sellerKey, nonce);

  assert(!invoices.member(disclose(invoiceId)), "quietbooks: invoice id already used");

  const frame = TermsFrame {
    invoiceId: invoiceId,
    sellerKey: sellerKey,
    buyerKey: disclose(buyerKey),
    dueDate: disclose(dueDate),
    terms: invoiceTerms()
  };

  assertTermsValid(frame, disclose(issuedAt));

  // An invoice with an arbiter has to be able to pay either side.
  //
  // `resolveDispute` binds the arbiter's payment to the address the terms name
  // for the party the ruling favours. So on an invoice that names no buyer
  // address, a ruling for the buyer sends the escrow to the zero key and burns
  // it; on one that names the seller's address for both sides, it hands the
  // escrow to the seller. The seller writes the terms and the seller is the one
  // who gains from either outcome, so without this rule a seller can issue an
  // invoice an arbiter is structurally unable to rule against -- which is the
  // one thing naming an arbiter is supposed to prevent.
  assert(arbiterKey == default<Bytes<32>> ||
         (frame.terms.buyerPayout != default<Bytes<32>> &&
          frame.terms.buyerPayout != frame.terms.sellerPayout),
         "quietbooks: an invoice with an arbiter needs a buyer payout address of its own");

  invoices.insert(disclose(invoiceId), InvoiceAnchor {
    status: InvoiceStatus.issued,
    terms: disclose(commitTerms(frame, termsSalt())),
    fieldRoot: disclose(commitFieldRoot(frame, fieldSalts())),
    sellerKey: disclose(sellerKey),
    buyerKey: disclose(buyerKey),
    arbiterKey: disclose(arbiterKey),
    issuedAt: disclose(issuedAt),
    dueDate: disclose(dueDate),
    settledAt: 0 as Uint<64>,
    escrowDeadline: 0 as Uint<64>,
    rulesVersion: RULES_VERSION()
  });

  issuedCount.increment(1);
  return disclose(invoiceId);
}

// Was this settled on or before the due date, according to the chain?
//
// Every settlement path used to decide this from a `settledAt` the caller passed
// in. In `settleAttested` the caller is the seller, so a seller marked their own
// punctuality; in the others the payer marked the seller's. Either way the
// counter it feeds -- the record the product asks a counterparty to trust -- was
// self-certified. The block time is the one clock nobody at the keyboard owns.
circuit onTimeNow(dueDate: Uint<64>): Boolean {
  return !blockTimeGt(dueDate);
}

// Prove the caller holds terms that open this invoice's commitment. Used by
// every settlement path: it is what stops a party from acting on an invoice
// whose terms they cannot open, and it is the only reason the contract can be
// sure the hidden amount it never sees is the one both sides agreed to.
//
// The terms are passed IN rather than read here, and that is the whole point.
// `invoiceTerms()` is a witness: the prover supplies it, and every call is an
// independent private input. A circuit that read it here and then read it again
// to check an amount would be comparing two unrelated values -- the first proven
// against the commitment, the second free. A malicious prover returns the real
// terms to this circuit and anything they like to the next.
//
// Threading one read through every use is what makes "the terms are the ones the
// chain committed to" true rather than merely intended. `hostile-witness.test.ts`
// holds that claim down with a prover that actually lies.
circuit assertHoldsTerms(invoiceId: Bytes<32>, anchor: InvoiceAnchor, terms: InvoiceTerms): [] {
  const frame = TermsFrame {
    invoiceId: invoiceId,
    sellerKey: anchor.sellerKey,
    buyerKey: anchor.buyerKey,
    dueDate: anchor.dueDate,
    terms: terms
  };
  assert(commitTerms(frame, termsSalt()) == anchor.terms,
         "quietbooks: terms do not open the recorded commitment");
}

// Settle privately: the buyer pays the seller inside the same transaction that
// records the settlement, and the contract never holds the money.
//
// `receiveShielded` requires the coin to exist as an output addressed to this
// contract; `sendImmediateShielded` forwards it to the seller in the same call.
// The contract's balance therefore changes by zero and nothing is ever in its
// custody. Zswap hides the value on both legs, so what reaches public state is
// two commitments, a status and a date.
//
// An earlier version of this circuit took a bare note commitment and handed it
// to `kernel.claimZswapCoinReceive`. That shape cannot work, and the in-process
// tests could not show it: the ledger requires every contract-associated
// commitment to be claimed by the contract that owns it, so a receive claim
// only ever accepts the commitment of an output addressed to THIS contract. A
// buyer-to-seller payment is addressed to the seller, so the claim was
// unsatisfiable and the node refused every such transaction as malformed. The
// forwarder shape below is what the platform supports, and it is the shape
// OpenZeppelin's `ForwarderShielded._deposit` uses.
export circuit settleWithNote(
  invoiceId: Bytes<32>,
  buyerPin: Uint<64>,
  coin: ShieldedCoinInfo,
  sellerPayout: ZswapCoinPublicKey,
  settledAt: Uint<64>
): [] {
  assertNotPaused();
  const id = disclose(invoiceId);
  const at = disclose(settledAt);

  assert(invoices.member(id), "quietbooks: unknown invoice");
  const anchor = invoices.lookup(id);
  assert(anchor.status == InvoiceStatus.issued, "quietbooks: invoice is not open for settlement");

  const buyerKey = callerKey(buyerPin);
  assert(disclose(buyerKey) == anchor.buyerKey, "quietbooks: caller is not the buyer");

  // Read once, then used for everything: the commitment check and the payment
  // checks have to be about the same terms. See `assertHoldsTerms`.
  const terms = invoiceTerms();
  assertHoldsTerms(id, anchor, terms);

  // The payment has to be the invoiced total, in the invoiced token, to the
  // address the invoice names. All three come from terms that have just been
  // proven to open the chain's commitment, and none of the three figures reaches
  // public state.
  assert(coin.value == terms.amount + terms.taxAmount,
         "quietbooks: payment does not equal the invoice total");
  assert(coin.color == terms.tokenType,
         "quietbooks: payment is not in the token this invoice is payable in");
  assert(disclose(sellerPayout).bytes == terms.sellerPayout,
         "quietbooks: payment is not addressed to the seller on this invoice");

  receiveShielded(disclose(coin));
  sendImmediateShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(disclose(sellerPayout)),
    disclose(coin.value)
  );

  const n = disclose(commitPaidCoin(coin));
  const onTime = onTimeNow(anchor.dueDate);

  settlements.insert(id, Settlement {
    mode: SettlementMode.privateNote,
    note: n,
    receipt: disclose(commitSettlementReceipt(id, n, buyerKey, settlementSalt())),
    settledAt: at,
    onTime: onTime
  });

  invoices.insert(id, withStatus(anchor, InvoiceStatus.settled, at));
  bumpSettled(anchor.sellerKey, onTime);
  settledCount.increment(1);
}

// Settle by seller attestation, for payments the contract cannot observe: a bank
// transfer, a transfer made in an earlier block, or any off-chain rail.
//
// Only the seller may call this. That is deliberate .. the seller is the party
// who loses if they mark an unpaid invoice as settled, so the incentive points
// the right way. The receipt digest is whatever reference the seller wants an
// auditor to be able to check.
export circuit settleAttested(
  invoiceId: Bytes<32>,
  sellerPin: Uint<64>,
  receiptDigest: Bytes<32>,
  settledAt: Uint<64>
): [] {
  assertNotPaused();
  const id = disclose(invoiceId);
  const at = disclose(settledAt);

  assert(invoices.member(id), "quietbooks: unknown invoice");
  const anchor = invoices.lookup(id);
  assert(anchor.status == InvoiceStatus.issued, "quietbooks: invoice is not open for settlement");

  const sellerKey = callerKey(sellerPin);
  assert(disclose(sellerKey) == anchor.sellerKey, "quietbooks: caller is not the seller");

  assertHoldsTerms(id, anchor, invoiceTerms());

  const onTime = onTimeNow(anchor.dueDate);

  settlements.insert(id, Settlement {
    mode: SettlementMode.attested,
    note: disclose(receiptDigest),
    receipt: disclose(commitSettlementReceipt(id, receiptDigest, sellerKey, settlementSalt())),
    settledAt: at,
    onTime: onTime
  });

  invoices.insert(id, withStatus(anchor, InvoiceStatus.settled, at));
  bumpSettled(anchor.sellerKey, onTime);
  settledCount.increment(1);
}

// Rebuilds an anchor with a new status and settlement time. Compact has no
// record-update syntax, so every field is restated; keeping that in one place
// stops a future edit from silently dropping one.
circuit withStatus(a: InvoiceAnchor, status: InvoiceStatus, settledAt: Uint<64>): InvoiceAnchor {
  return InvoiceAnchor {
    status: status,
    terms: a.terms,
    fieldRoot: a.fieldRoot,
    sellerKey: a.sellerKey,
    buyerKey: a.buyerKey,
    arbiterKey: a.arbiterKey,
    issuedAt: a.issuedAt,
    dueDate: a.dueDate,
    settledAt: settledAt,
    escrowDeadline: a.escrowDeadline,
    rulesVersion: a.rulesVersion
  };
}

circuit withEscrow(a: InvoiceAnchor, status: InvoiceStatus, deadline: Uint<64>): InvoiceAnchor {
  return InvoiceAnchor {
    status: status,
    terms: a.terms,
    fieldRoot: a.fieldRoot,
    sellerKey: a.sellerKey,
    buyerKey: a.buyerKey,
    arbiterKey: a.arbiterKey,
    issuedAt: a.issuedAt,
    dueDate: a.dueDate,
    settledAt: a.settledAt,
    escrowDeadline: deadline,
    rulesVersion: a.rulesVersion
  };
}

// Cancel an unpaid invoice. Seller only, and only while it is still open .. a
// settled invoice is a record of something that happened and must not be
// retractable.
export circuit cancelInvoice(invoiceId: Bytes<32>, sellerPin: Uint<64>): [] {
  assertNotPaused();
  const id = disclose(invoiceId);

  assert(invoices.member(id), "quietbooks: unknown invoice");
  const anchor = invoices.lookup(id);
  assert(anchor.status == InvoiceStatus.issued, "quietbooks: only an open invoice can be cancelled");

  const sellerKey = callerKey(sellerPin);
  assert(disclose(sellerKey) == anchor.sellerKey, "quietbooks: caller is not the seller");

  invoices.insert(id, withStatus(anchor, InvoiceStatus.cancelled, anchor.settledAt));
  bumpCancelled(anchor.sellerKey);
  cancelledCount.increment(1);
}

// ---------------------------------------------------------------------------
// Escrow mode.
//
// The contract takes custody. `receiveShielded` discloses the coin, so the
// escrowed value is public for as long as it is held, and the vault entry keeps
// it public afterwards. Parties choose this only when a locked balance matters
// more than a hidden one; the interface says so before they commit.
// ---------------------------------------------------------------------------

// Buyer locks the payment with the contract.
//
// There is no `fundedAt` argument. There was, and once the deadline started
// being checked against the block instead of against it, nothing read it -- but
// it was still a public field on every funding transaction, and a timestamp in
// the clear is exactly the kind of thing that correlates a buyer across
// invoices. A parameter that costs privacy and buys nothing is worse than no
// parameter.
export circuit fundEscrow(
  invoiceId: Bytes<32>,
  buyerPin: Uint<64>,
  coin: ShieldedCoinInfo,
  deadline: Uint<64>
): [] {
  assertNotPaused();
  const id = disclose(invoiceId);

  assert(invoices.member(id), "quietbooks: unknown invoice");
  const anchor = invoices.lookup(id);
  assert(anchor.status == InvoiceStatus.issued, "quietbooks: invoice is not open for escrow");

  const buyerKey = callerKey(buyerPin);
  assert(disclose(buyerKey) == anchor.buyerKey, "quietbooks: caller is not the buyer");

  const terms = invoiceTerms();
  assertHoldsTerms(id, anchor, terms);

  // Against the chain's clock, not against another argument. Comparing the
  // deadline to a `fundedAt` the same caller supplies says nothing at all: both
  // were chosen together, so the assertion held for a deadline already in the
  // past, and the buyer could refund themselves in the next block.
  assert(blockTimeLt(disclose(deadline)), "quietbooks: escrow deadline must be in the future");

  // The full invoiced total, in the invoiced token. Releasing an escrow marks
  // the invoice settled and credits the seller, so an escrow worth less than the
  // invoice is a settlement for less than the invoice.
  assert(coin.value == terms.amount + terms.taxAmount,
         "quietbooks: escrow must equal the invoice total");
  assert(coin.color == terms.tokenType,
         "quietbooks: escrow is not in the token this invoice is payable in");

  // The coin must appear as an output addressed to this contract in this
  // transaction, or the ledger rejects the call.
  receiveShielded(disclose(coin));
  escrowVault.insertCoin(id, disclose(coin), right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));

  invoices.insert(id, withEscrow(anchor, InvoiceStatus.escrowFunded, disclose(deadline)));
}

// Buyer confirms delivery and the contract pays the seller.
export circuit releaseEscrow(
  invoiceId: Bytes<32>,
  buyerPin: Uint<64>,
  sellerPayout: ZswapCoinPublicKey,
  releasedAt: Uint<64>
): [] {
  assertNotPaused();
  const id = disclose(invoiceId);
  const at = disclose(releasedAt);

  assert(invoices.member(id), "quietbooks: unknown invoice");
  const anchor = invoices.lookup(id);
  assert(anchor.status == InvoiceStatus.escrowFunded, "quietbooks: invoice has no funded escrow");

  const buyerKey = callerKey(buyerPin);
  assert(disclose(buyerKey) == anchor.buyerKey, "quietbooks: caller is not the buyer");

  assert(escrowVault.member(id), "quietbooks: escrow vault entry missing");
  const held = escrowVault.lookup(id);

  // To the seller this invoice names, not to whoever asked. Without this the
  // buyer -- who is the only caller here -- could release the escrow to
  // themselves and still have the invoice recorded as settled.
  const terms = invoiceTerms();
  assertHoldsTerms(id, anchor, terms);
  assert(disclose(sellerPayout).bytes == terms.sellerPayout,
         "quietbooks: release is not addressed to the seller on this invoice");

  sendShielded(held, left<ZswapCoinPublicKey, ContractAddress>(disclose(sellerPayout)), held.value);
  escrowVault.remove(id);

  const onTime = onTimeNow(anchor.dueDate);
  settlements.insert(id, Settlement {
    mode: SettlementMode.escrow,
    note: commitEscrowCoin(held),
    receipt: disclose(commitSettlementReceipt(id, commitEscrowCoin(held), buyerKey, settlementSalt())),
    settledAt: at,
    onTime: onTime
  });

  invoices.insert(id, withStatus(anchor, InvoiceStatus.settled, at));
  bumpSettled(anchor.sellerKey, onTime);
  settledCount.increment(1);
}

// After the deadline, the buyer takes their money back. Only the buyer may call
// this, and only once the deadline has genuinely passed on chain .. the time is
// read from the block, not from an argument, so it cannot be forged.
// Deliberately callable while paused, like `revokeAudit`.
//
// Every other state-advancing circuit stops on a pause. This one must not: the
// deadline has already passed, the money is the buyer's, and an administrator
// who pauses -- or who loses their key while paused -- would otherwise trap it
// with no way out. A pause is an emergency stop on new business, not a freeze on
// funds somebody is already owed back.
export circuit refundEscrow(
  invoiceId: Bytes<32>,
  buyerPin: Uint<64>,
  buyerPayout: ZswapCoinPublicKey
): [] {
  const id = disclose(invoiceId);

  assert(invoices.member(id), "quietbooks: unknown invoice");
  const anchor = invoices.lookup(id);
  assert(anchor.status == InvoiceStatus.escrowFunded, "quietbooks: invoice has no funded escrow");

  const buyerKey = callerKey(buyerPin);
  assert(disclose(buyerKey) == anchor.buyerKey, "quietbooks: caller is not the buyer");

  assert(blockTimeGt(anchor.escrowDeadline), "quietbooks: escrow deadline has not passed");

  assert(escrowVault.member(id), "quietbooks: escrow vault entry missing");
  const held = escrowVault.lookup(id);

  // `buyerPayout` is deliberately not bound to `terms.buyerPayout`, and this is
  // the only paying circuit where that is right. Everywhere else the address is
  // bound because the caller is directing somebody else's money: the buyer
  // paying the seller, the arbiter paying whichever side won. Here the caller
  // has already proven they are the buyer and the money is going back to the
  // buyer, so the only person a free choice of address can hurt is the person
  // making it. Binding it would also mean an invoice issued without a buyer
  // address could never be refunded, which turns a deadline into a trap.
  sendShielded(held, left<ZswapCoinPublicKey, ContractAddress>(disclose(buyerPayout)), held.value);
  escrowVault.remove(id);

  invoices.insert(id, withEscrow(anchor, InvoiceStatus.refunded, anchor.escrowDeadline));
}

// ---------------------------------------------------------------------------
// Disputes
// ---------------------------------------------------------------------------

// Either party opens a dispute on a funded escrow. Requires an arbiter to have
// been named when the invoice was issued, so a party cannot manufacture a forum
// after the fact.
export circuit openDispute(invoiceId: Bytes<32>, partyPin: Uint<64>): [] {
  assertNotPaused();
  const id = disclose(invoiceId);

  assert(invoices.member(id), "quietbooks: unknown invoice");
  const anchor = invoices.lookup(id);
  assert(anchor.status == InvoiceStatus.escrowFunded, "quietbooks: only a funded escrow can be disputed");
  assert(anchor.arbiterKey != default<Bytes<32>>, "quietbooks: invoice has no arbiter");

  const partyKey = disclose(callerKey(partyPin));
  assert(partyKey == anchor.sellerKey || partyKey == anchor.buyerKey,
         "quietbooks: caller is not a party to this invoice");

  disputes.insert(id, DisputeOutcome.undecided);
  invoices.insert(id, withEscrow(anchor, InvoiceStatus.disputed, anchor.escrowDeadline));
  bumpDisputeOpened(partyKey);
  disputedCount.increment(1);
}

// The named arbiter decides, and the escrowed coin moves in the same call. The
// contract only lets them choose a direction; the address each direction pays is
// fixed by the invoice.
//
// That binding has a price, and it is worth stating plainly: proving it needs
// the terms, so the arbiter has to hold the invoice openings, which means the
// arbiter sees the amount. An earlier version of this comment claimed they never
// did, and it was written before the binding existed. The alternative is an
// arbiter who rules for one party and pays a third, so the disclosure is the
// cheaper of the two. It is a disclosure to one named party the seller chose,
// not to the chain: nothing here reaches public state.
export circuit resolveDispute(
  invoiceId: Bytes<32>,
  arbiterPin: Uint<64>,
  forSeller: Boolean,
  payout: ZswapCoinPublicKey,
  resolvedAt: Uint<64>
): [] {
  assertNotPaused();
  const id = disclose(invoiceId);
  const at = disclose(resolvedAt);

  assert(invoices.member(id), "quietbooks: unknown invoice");
  const anchor = invoices.lookup(id);
  assert(anchor.status == InvoiceStatus.disputed, "quietbooks: invoice is not under dispute");

  const arbiterKey = disclose(callerKey(arbiterPin));
  assert(arbiterKey == anchor.arbiterKey, "quietbooks: caller is not the named arbiter");

  assert(escrowVault.member(id), "quietbooks: escrow vault entry missing");
  const held = escrowVault.lookup(id);

  const decided = disclose(forSeller);

  // The verdict picks the address; the arbiter does not. `forSeller` and
  // `payout` used to be unrelated arguments, so an arbiter could rule for one
  // party and send the money to a third -- themselves, for instance.
  const terms = invoiceTerms();
  assertHoldsTerms(id, anchor, terms);
  assert(disclose(payout).bytes == (decided ? terms.sellerPayout : terms.buyerPayout),
         "quietbooks: payout does not match the party the ruling favours");

  sendShielded(held, left<ZswapCoinPublicKey, ContractAddress>(disclose(payout)), held.value);
  escrowVault.remove(id);
  disputes.insert(id, decided ? DisputeOutcome.forSeller : DisputeOutcome.forBuyer);

  // The losing side carries the mark. A seller who loses failed to deliver; a
  // buyer who loses withheld payment that was owed.
  bumpDisputeLost(decided ? anchor.buyerKey : anchor.sellerKey);

  if (decided) {
    // A seller who wins a dispute has been paid, so the invoice gets a
    // settlement record like every other payment path. Without one it would
    // count toward the settled totals and the seller's reliability while
    // leaving nothing for an auditor to look at, which is the sort of
    // asymmetry that turns into a reconciliation bug a year later.
    //
    // The receipt is deliberately zero rather than a commitment. A receipt
    // commits to the payer's identity under a settlement salt only that payer
    // holds, and the arbiter is neither party: they hold the invoice openings,
    // not the payer's salt. Publishing a digest that hides nothing would be
    // worse than publishing an explicit absence: an auditor reading a zero
    // receipt knows immediately that this settlement was decided rather than
    // paid.
    // One reading of the clock, used for both. They were two: the record took
    // the block's answer and the counter took `at <= anchor.dueDate`, a date the
    // arbiter supplies. So the seller's public reliability could say on time
    // while the settlement record beside it said late, and the number a
    // counterparty is asked to trust was still one a caller chose.
    const onTime = onTimeNow(anchor.dueDate);

    settlements.insert(id, Settlement {
      mode: SettlementMode.escrow,
      note: commitEscrowCoin(held),
      receipt: default<Bytes<32>>,
      settledAt: at,
      onTime: onTime
    });
    bumpSettled(anchor.sellerKey, onTime);
    settledCount.increment(1);
  }

  invoices.insert(id, withStatus(anchor, InvoiceStatus.resolved, at));
}

// ---------------------------------------------------------------------------
// Selective audit
// ---------------------------------------------------------------------------

// The seller grants an auditor sight of specific fields, until a deadline.
//
// The audit key itself never touches the chain .. only its hash. The seller hands
// the key to the auditor out of band along with an encrypted envelope; the
// auditor decrypts, recomputes the per-field commitments for the fields in
// `scopes`, and checks them against the `fieldRoot` already on this invoice's
// anchor. The chain's role is to pin what was authorised, by whom, and until when.
export circuit grantAudit(
  invoiceId: Bytes<32>,
  sellerPin: Uint<64>,
  auditKeyHash: Bytes<32>,
  scopes: Vector<9, Boolean>,
  expiresAt: Uint<64>,
  grantedAt: Uint<64>
): [] {
  assertNotPaused();
  const id = disclose(invoiceId);

  assert(invoices.member(id), "quietbooks: unknown invoice");
  const anchor = invoices.lookup(id);

  const sellerKey = callerKey(sellerPin);
  assert(disclose(sellerKey) == anchor.sellerKey, "quietbooks: caller is not the seller");

  assert(disclose(auditKeyHash) != default<Bytes<32>>, "quietbooks: audit key hash must be set");
  assert(anyScope(disclose(scopes)), "quietbooks: grant must disclose at least one field");
  // Against the chain's clock. Comparing two arguments the same caller chose
  // was vacuous, and `audit.ts` told readers the contract enforced this.
  assert(blockTimeLt(disclose(expiresAt)), "quietbooks: grant must expire in the future");

  auditGrants.insert(id, AuditGrant {
    auditKeyHash: disclose(auditKeyHash),
    scopes: disclose(scopes),
    grantedAt: disclose(grantedAt),
    expiresAt: disclose(expiresAt),
    revoked: false
  });
}

// True when at least one slot is set. A grant that discloses nothing is almost
// certainly a mistake in the caller, so it is refused rather than stored.
circuit anyScope(s: Vector<9, Boolean>): Boolean {
  return s[0] || s[1] || s[2] || s[3] || s[4] || s[5] || s[6] || s[7] || s[8];
}

// Revoke early. Works while paused: a seller who needs to withdraw an auditor's
// access should never be blocked by an unrelated emergency stop.
export circuit revokeAudit(invoiceId: Bytes<32>, sellerPin: Uint<64>): [] {
  const id = disclose(invoiceId);

  assert(invoices.member(id), "quietbooks: unknown invoice");
  const anchor = invoices.lookup(id);

  const sellerKey = callerKey(sellerPin);
  assert(disclose(sellerKey) == anchor.sellerKey, "quietbooks: caller is not the seller");

  assert(auditGrants.member(id), "quietbooks: no audit grant for this invoice");
  const g = auditGrants.lookup(id);

  auditGrants.insert(id, AuditGrant {
    auditKeyHash: g.auditKeyHash,
    scopes: g.scopes,
    grantedAt: g.grantedAt,
    expiresAt: g.expiresAt,
    revoked: true
  });
}

// ---------------------------------------------------------------------------
// Reliability proof
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Administration
// ---------------------------------------------------------------------------

export circuit setPaused(value: Boolean): [] {
  assertAdmin();
  paused = disclose(value);
}
